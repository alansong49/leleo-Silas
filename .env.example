# 复制成 .env.local 后填入真实值（.env.local 已被 .gitignore 忽略，不会进仓库）
# 这些值只影响「后台一键提交 config 到 GitHub」功能，缺失时用代码里的默认值

VITE_GITHUB_OWNER=alansong49
VITE_GITHUB_REPO=leleo-Silas
VITE_GITHUB_BRANCH=main

# GitHub App ID（可选，用于后台提交）
VITE_GITHUB_APP_ID=

# 注意：Personal Access Token 不要写进环境变量文件后提交，
# 站点运行时的 Token 请在页面「管理密码」解锁后，在提交对话框里填写（仅存于浏览器 cookie）
